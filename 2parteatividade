from abc import ABC, abstractmethod

# S - Princípio da Responsabilidade Única: Separação das responsabilidades em diferentes classes
class TarefaBase(ABC):
    def __init__(self, descricao):
        self._descricao = descricao
        self._concluida = False
    
    @abstractmethod
    def mostrar_info(self):
        pass
    
    def marcar_concluida(self):
        self._concluida = True
    
    def obter_descricao(self):
        return self._descricao
    
    def esta_concluida(self):
        return self._concluida

# O - Princípio Aberto/Fechado: Permite a extensão sem modificar a classe base
class Tarefa(TarefaBase):
    def mostrar_info(self):
        status = "Concluída" if self.esta_concluida() else "Pendente"
        return f"{self.obter_descricao()} - {status}"

# Exemplo de extensão sem modificar a classe existente
class TarefaPrioritaria(Tarefa):
    def __init__(self, descricao, prioridade):
        super().__init__(descricao)
        self._prioridade = prioridade
    
    def mostrar_info(self):
        status = "Concluída" if self.esta_concluida() else "Pendente"
        return f"{self.obter_descricao()} - Prioridade {self._prioridade} - {status}"

# L - Princípio da Substituição de Liskov: Permite substituir Tarefa por qualquer subclasse
class GerenciadorTarefas:
    def __init__(self):
        self._tarefas = []
    
    def adicionar_tarefa(self, tarefa: TarefaBase):
        if isinstance(tarefa, TarefaBase):
            self._tarefas.append(tarefa)
            print("Tarefa adicionada com sucesso!")
        else:
            print("Erro: O objeto não é uma tarefa válida!")
    
    def listar_tarefas(self):
        if not self._tarefas:
            print("Nenhuma tarefa encontrada.")
        else:
            for i, tarefa in enumerate(self._tarefas, 1):
                print(f"{i}. {tarefa.mostrar_info()}")
    
    def marcar_concluida(self, indice):
        try:
            self._tarefas[indice - 1].marcar_concluida()
            print("Tarefa marcada como concluída!")
        except (IndexError, ValueError):
            print("Índice inválido!")
    
    def remover_tarefa(self, indice):
        try:
            del self._tarefas[indice - 1]
            print("Tarefa removida com sucesso!")
        except (IndexError, ValueError):
            print("Índice inválido!")

# I - Princípio da Segregação de Interface: A classe TarefaBase tem apenas métodos essenciais

# D - Princípio da Inversão de Dependência: GerenciadorTarefas depende da abstração TarefaBase

def main():
    gerenciador = GerenciadorTarefas()
    
    while True:
        print("\nMenu:")
        print("1. Adicionar Tarefa")
        print("2. Adicionar Tarefa Prioritária")
        print("3. Listar Tarefas")
        print("4. Marcar Tarefa como Concluída")
        print("5. Remover Tarefa")
        print("6. Sair")
        
        opcao = input("Escolha uma opção: ")
        
        if opcao == "1":
            descricao = input("Digite a descrição da tarefa: ")
            gerenciador.adicionar_tarefa(Tarefa(descricao))
        elif opcao == "2":
            descricao = input("Digite a descrição da tarefa prioritária: ")
            prioridade = input("Digite a prioridade (Alta, Média, Baixa): ")
            gerenciador.adicionar_tarefa(TarefaPrioritaria(descricao, prioridade))
        elif opcao == "3":
            gerenciador.listar_tarefas()
        elif opcao == "4":
            try:
                indice = int(input("Digite o número da tarefa a ser concluída: "))
                gerenciador.marcar_concluida(indice)
            except ValueError:
                print("Por favor, insira um número válido.")
        elif opcao == "5":
            try:
                indice = int(input("Digite o número da tarefa a ser removida: "))
                gerenciador.remover_tarefa(indice)
            except ValueError:
                print("Por favor, insira um número válido.")
        elif opcao == "6":
            print("Saindo... Até mais!")
            break
        else:
            print("Opção inválida! Tente novamente.")

if __name__ == "__main__":
    main()
